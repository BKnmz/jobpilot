# Copy this file to .env and fill in your key, or paste the key in the app's Settings tab.
# Get a Google Gemini API key (free tier, no credit card): https://aistudio.google.com/app/apikey

GEMINI_API_KEY=

# The model is chosen in Settings -> "AI provider and model" from the models your key can use.
# These two are only starting defaults for a fresh install and may be left out:
# GEMINI_MODEL=
# GEMINI_SCORE_MODEL=

# Optional: keep your data (database, CVs, browser login) somewhere other than this folder.
# JOBPILOT_HOME=C:\Users\you\Documents\jobpilot-data

# Optional: use a browser other than the detected Edge/Chrome for scraping.
# JOBPILOT_BROWSER=C:\Program Files\Google\Chrome\Application\chrome.exe
